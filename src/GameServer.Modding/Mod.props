<Project>
  <!-- What makes a project a mod; the root Directory.Build.props imports it for a project in Mods/Source/ (Mods/ is the
       user's, gitignored). Mods/Source/<Name>/<Name>.csproj builds into Mods/Binaries/<name>/ as <name>.dll beside its
       mod.json, where the running Gateway sees the new files and reloads the mod (Agents/docs/dev/modding.md). -->
  <PropertyGroup>
    <ModId>$(MSBuildProjectName.ToLowerInvariant())</ModId>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(ModId)</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\Mods\Binaries\$(ModId)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against, not copied: every mod uses the Gateway's own GameServer.Modding, and can alter the game as fully as a
         module (Agents/docs/dev/modding.md): the server itself, the client protocol and shared types, and the game's rules. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)GameServer.Modding.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\GameServer.Gateway\GameServer.Gateway.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\GameServer.Core\GameServer.Core.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Modules\Core\Game\Game.csproj" Private="false" />
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Its settings, when it has any (Agents/docs/dev/modding.md, "Settings"). -->
    <None Include="settings.json" Condition="Exists('settings.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
