<Project>
  <!-- What makes a project a module, wherever it is: Modules/Directory.Build.props imports this for the repository's own, and
       a package's module in another repository imports it from its LocalExile checkout, so a module builds the same in
       both and moves between them with its folder (Agents/docs/dev/modding.md, "Packages").
       <any folders>/<id>/<Name>.csproj builds into that folder's bin/ as <id>.dll. -->
  <PropertyGroup>
    <!-- The LocalExile checkout, for a reference to another of its modules: $(LocalExileDir)Modules\Core\Content\Harvest\Harvest.csproj. -->
    <LocalExileDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..'))</LocalExileDir>
    <ModuleId>$(MSBuildProjectName.ToLowerInvariant())</ModuleId>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(ModuleId)</AssemblyName>
    <OutputPath>$(MSBuildProjectDirectory)\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against, not copied: every module uses the Gateway's own GameServer.Modding. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)GameServer.Modding.csproj" Private="false" />
    <!-- The server itself: a module can alter the game fully. -->
    <ProjectReference Include="$(LocalExileDir)src\GameServer.Gateway\GameServer.Gateway.csproj" Private="false" />
    <!-- The client protocol and shared types. -->
    <ProjectReference Include="$(LocalExileDir)src\GameServer.Core\GameServer.Core.csproj" Private="false" />
  </ItemGroup>

  <!-- The game's rules. Not copied: the host loads the game module, and those that depend on it share it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Game'">
    <ProjectReference Include="$(LocalExileDir)Modules\Core\Game\Game.csproj" Private="false" />
    <Using Include="Program" Static="true" />
    <Using Include="Game" Static="true" />
  </ItemGroup>
</Project>
