<Project Sdk="Microsoft.NET.Sdk">

  <!-- The API mods and modules see (Agents/docs/dev/modding.md, modules.md). The Gateway implements these contracts, and its own
       types stay internal. It uses GameServer.Core's client protocol and items, which modules may use and mods may not. -->
  <ItemGroup>
    <ProjectReference Include="..\GameServer.Core\GameServer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Mods are built against main, which has the default version 1.0.0.0, and .NET will not bind them to a lower one. A
         release's -p:Version would make this 0.x and stop every downloaded mod from loading. Raise it only when the API
         breaks; the product version still carries the release. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
