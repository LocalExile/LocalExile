<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameServer.Core\GameServer.Core.csproj" />
    <ProjectReference Include="..\GameServer.Storage\GameServer.Storage.csproj" />
    <!-- The mods' API (ModHost, Program.Mods.cs). -->
    <ProjectReference Include="..\GameServer.Modding\GameServer.Modding.csproj" />
    <!-- The game files and the level generator port (ServerLevels.cs). -->
    <ProjectReference Include="..\GameServer.Data\GameServer.Data.csproj" />
    <!-- Compiles a mod's loose .cs files (ModScripts.cs). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- The Gateway's types are public: modules and mods reach the whole server (Agents/docs/dev/modding.md). -->
  <ItemGroup>
    <InternalsVisibleTo Include="GameServer.Gateway.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The connection's state is assigned by the game module, which the compiler does not see here. -->
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
  </PropertyGroup>

</Project>
