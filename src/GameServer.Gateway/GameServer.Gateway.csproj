<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameServer.Core\GameServer.Core.csproj" />
    <ProjectReference Include="..\GameServer.Storage\GameServer.Storage.csproj" />
    <!-- The mods' API (ModHost, Program.Mods.cs). -->
    <ProjectReference Include="..\GameServer.Modding\GameServer.Modding.csproj" />
    <!-- The game files and the level generator port (ServerLevels.cs). -->
    <ProjectReference Include="..\GameServer.Data\GameServer.Data.csproj" />
    <!-- Compiles a mod's loose .cs files (ModScripts.cs). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- The Gateway's types are internal (top-level program); its tests and the modules reach them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GameServer.Gateway.Tests" />
    <InternalsVisibleTo Include="game" />
    <InternalsVisibleTo Include="atlas" />
    <InternalsVisibleTo Include="bench" />
    <InternalsVisibleTo Include="commands" />
    <InternalsVisibleTo Include="cosmetics" />
    <InternalsVisibleTo Include="delve" />
    <InternalsVisibleTo Include="harvest" />
    <InternalsVisibleTo Include="heist" />
    <InternalsVisibleTo Include="hideoutediting" />
    <InternalsVisibleTo Include="npcdialogue" />
    <InternalsVisibleTo Include="pantheon" />
    <InternalsVisibleTo Include="portals" />
    <InternalsVisibleTo Include="phreciaascendancies" />
    <InternalsVisibleTo Include="questobjects" />
    <InternalsVisibleTo Include="ruthless" />
    <InternalsVisibleTo Include="social" />
    <InternalsVisibleTo Include="tattoos" />
    <InternalsVisibleTo Include="uniquebelts" />
    <InternalsVisibleTo Include="vendors" />
    <!-- scripts/re/exits: the offline area transition audit. -->
    <InternalsVisibleTo Include="exits" />
    <!-- scripts/perf/PerfBench: the in-process performance measurements (Agents/docs/dev/performance.md). -->
    <InternalsVisibleTo Include="perfbench" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The connection's state is assigned by the game module, which the compiler does not see here. -->
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
  </PropertyGroup>

</Project>
