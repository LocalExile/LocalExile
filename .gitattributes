# Merge these lists by keeping both sides' lines, so a local merge of two pull requests' entries does not conflict.
# Prose docs stay out: a merged mix of two versions could become a false fact. Agents/docs/dev/pr-checks.md
Agents/status/*.md merge=union
Agents/roadmap/*.md merge=union
Agents/Status.md merge=union
Agents/Roadmap.md merge=union
Agents/docs/README.md merge=union

# SQL in git is hashed by the database updater after line ends are made LF; keep the checkout LF too
# (Agents/docs/dev/databases.md).
sql/**/*.sql text eol=lf
