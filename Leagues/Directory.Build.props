<Project>
  <!-- The repository's settings (nullable, warnings as errors), then what makes a project here a league. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- A league's own code (optional): Leagues/<Name>/<Name>.csproj builds into its bin/ (gitignored). The running Gateway hot-reloads
       a new build (Agents/docs/dev/modules.md). -->
  <PropertyGroup>
    <ModuleId>$(MSBuildProjectName.ToLowerInvariant())</ModuleId>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(ModuleId)</AssemblyName>
    <OutputPath>$(MSBuildProjectDirectory)\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against, not copied: every module uses the Gateway's own GameServer.Modding. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\GameServer.Modding\GameServer.Modding.csproj" Private="false" />
    <!-- The client protocol and shared types: modules may use them; the Gateway stays internal. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\GameServer.Core\GameServer.Core.csproj" Private="false" />
  </ItemGroup>
</Project>
