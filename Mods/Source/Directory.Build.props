<Project>
  <!-- The repository's settings (nullable, warnings as errors), then what makes a project here a mod. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- A first-party mod: Mods/Source/<Name>/<Name>.csproj builds into Mods/Binaries/<name>/ (gitignored) as <name>.dll beside its
       mod.json. The running Gateway sees the new files and reloads the mod (Agents/docs/dev/modding.md). -->
  <PropertyGroup>
    <ModId>$(MSBuildProjectName.ToLowerInvariant())</ModId>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(ModId)</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\Binaries\$(ModId)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against, not copied: every mod uses the Gateway's own GameServer.Modding. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\GameServer.Modding\GameServer.Modding.csproj" Private="false" />
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
