<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The player databases are built from sql/ (SqlUpdater); the tests run in their output folder. -->
    <None Include="..\..\sql\base\auth\*.sql" Link="sql\base\auth\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sql\base\characters\*.sql" Link="sql\base\characters\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sql\updates\auth\*.sql" Link="sql\updates\auth\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sql\updates\characters\*.sql" Link="sql\updates\characters\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer.Core\GameServer.Core.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Storage\GameServer.Storage.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Host\GameServer.Host.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Auth\GameServer.Auth.csproj" />
  </ItemGroup>
</Project>
