<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The commit in AssemblyInfo.cs changes it at the first build after a commit, and `dotnet watch` restarts the Gateway for it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The commit in the source link file is a compiler input: without this, each commit recompiles every project. -->
    <EnableSourceLink>false</EnableSourceLink>
    <!-- Mods are built against main, which has the default version 1.0.0.0, and .NET will not bind a mod to a lower one.
         A release's -p:Version would make the server's assemblies (Gateway, Core, Data, Storage, Modding, the modules) 0.x
         and stop every downloaded mod from loading. Raise it only when what mods use breaks; the product version still
         carries the release (InformationalVersion). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- A mod's project in Mods/Source/<Name>/ (the user's, gitignored) builds as a mod. -->
  <Import Project="src/GameServer.Modding/Mod.props"
          Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('Mods/Source/'))" />
</Project>
